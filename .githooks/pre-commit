#!/bin/bash
set -e

ROOT="$(git rev-parse --show-toplevel)"

# --- ruff: format + lint Python ---
RUFF="$ROOT/.venv/bin/ruff"
if [ ! -x "$RUFF" ]; then
    RUFF="ruff"
fi
echo "ruff format --check ..."
"$RUFF" format --check app tests
echo "ruff check ..."
"$RUFF" check app tests

# --- mdformat: reformat staged Markdown ---
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$STAGED_MD" ]; then
    MDFORMAT="$ROOT/.venv/bin/mdformat"
    if [ ! -x "$MDFORMAT" ]; then
        echo "mdformat not found at $MDFORMAT — skipping markdown formatting"
        echo "Run: pip install -r requirements-dev.txt"
    else
        echo "$STAGED_MD" | xargs "$MDFORMAT" --wrap 100
        echo "$STAGED_MD" | xargs git add
    fi
fi
