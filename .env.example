# -----------------------------------------------------------------------
# Klip — environment variable reference
# Copy to .env for local development; never commit .env to source control.
# In Cloud Run, all values below are injected via Secret Manager or
# --set-env-vars in deploy/deploy.sh.
# -----------------------------------------------------------------------

# GCP project and region
GCP_PROJECT=your-gcp-project-id
REGION=us-central1

# Gemini model
# Runs via Vertex AI; no API key needed. Auth is handled by ADC:
#   - Cloud Run: automatic via the attached service account (klip-sa).
#   - Local dev:  run `gcloud auth application-default login` once.
GEMINI_MODEL=gemini-2.5-flash

# OAuth 2.0 credentials (created in Google Cloud Console > APIs & Services > Credentials)
OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-client-secret

# Public URL of this service — set to the Cloud Run URL after first deploy.
# Used as the OAuth redirect base and for building card URLs.
APP_BASE_URL=https://klip-xxxx-uc.a.run.app

# JWT verification for Workspace Add-on events.
# ADDON_AUDIENCE: the full events endpoint URL (Google uses this as the JWT audience).
ADDON_AUDIENCE=https://klip-xxxx-uc.a.run.app/events

# ADDON_TOKEN_ISSUER: the gsuiteaddons service account for your project.
# Format: service-{PROJECT_NUMBER}@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
# Find your project number in Cloud Console > Project settings.
ADDON_TOKEN_ISSUER=service-REPLACE_WITH_PROJECT_NUMBER@gcp-sa-gsuiteaddons.iam.gserviceaccount.com

# Set to false for local development only (skips JWT verification).
# MUST be true in any internet-exposed deployment.
VERIFY_ADDON_TOKENS=true

# Seconds before the Gemini agentic loop is cancelled and an error is sent to the user.
GEMINI_TIMEOUT=60

# Public URL of an animated GIF shown in the "thinking" card while Gemini works.
# Must be publicly accessible (e.g. hosted on GCS with allUsers read access).
# Leave empty to show only the rotating phrase with no image.
KLIP_GIF_URL=https://storage.googleapis.com/klip-static/rotating-blue-circle-loader-20x20.gif

# Set to true to log full MCP HTTP request/response headers and bodies (very noisy).
DEBUG_MCP_HTTP=false

# Strip parameters not declared in a tool's MCP schema before dispatching to the MCP server.
# Workaround for Gemini hallucinating extra parameters (e.g. orderBy on gmail_search_threads).
STRIP_UNKNOWN_TOOL_PARAMS=false
